# Copy to .env and fill in real values.
# Format: API_KEYS=key1:tenant_id:scope1,scope2;key2:tenant_id:scope1

API_KEYS=dev-key:tenant_dev:predict,read_models;admin-key:tenant_admin:predict,read_models,admin

# PostgreSQL (Phase 2)
DATABASE_URL=postgresql://user:password@localhost:5432/inference_engine

# Redis (Phase 2)
REDIS_URL=redis://localhost:6379/0
