# Copy to .env and fill in real values.
# Format: API_KEYS=key1:tenant_id:scope1,scope2;key2:tenant_id:scope1

API_KEYS=dev-key:tenant_dev:predict,read_models;admin-key:tenant_admin:predict,read_models,admin

# Set to "production" to enforce API_KEYS at startup
# ENV=production

# PostgreSQL — when running via docker compose, use the service name "postgres"
# Leave unset to fall back to SQLite (zero-dependency quickstart)
DATABASE_URL=postgresql://inference:inference@postgres:5432/inference_engine

# Redis — when running via docker compose, use the service name "redis"
# Leave unset to use in-process thread pool
REDIS_URL=redis://redis:6379/0

# For local host-only runs (uvicorn on the host, not in Docker):
# DATABASE_URL=postgresql://inference:inference@127.0.0.1:15432/inference_engine
# REDIS_URL=redis://127.0.0.1:6379/0

# ── CLI ──────────────────────────────────────────────────────────────────────

# Groq API key (required for inference-engine deploy / fix)
GROQ_API_KEY=your-groq-api-key

# Override the default LLM model used for code generation (optional)
# INFERENCE_ENGINE_LLM_MODEL=llama-3.3-70b-versatile

# ── Observability ────────────────────────────────────────────────────────────

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=inference-engine
